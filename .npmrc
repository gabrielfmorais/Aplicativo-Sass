# Node major is pinned (DECISION-REGISTER D-43). Install fails early on an unsupported Node.
engine-strict=true
# Expo / Metro work best with a hoisted node_modules layout under pnpm.
node-linker=hoisted
# Lifecycle scripts of dependencies are NOT executed unless allow-listed in
# pnpm-workspace.yaml#onlyBuiltDependencies (supply-chain control, SECURITY-BASELINE §11).
strict-dep-builds=true
auto-install-peers=true
save-exact=false
