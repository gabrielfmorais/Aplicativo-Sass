# ============================================================
# .env.example — APENAS NOMES. Nunca commitar valores reais.
# Copie para .env.local (ignorado pelo git) e preencha.
# ============================================================

# --- apps/mobile (públicas por design; expostas no bundle via EXPO_PUBLIC_) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_ENV=            # development | preview | production
# --- Acesso DEV-only ao preview web (D-85) — NUNCA em preview/production ---
# Só tem efeito com __DEV__ && Platform.OS === 'web' && EXPO_PUBLIC_APP_ENV === 'development'.
# Credencial descartável de um usuário do SEU projeto DEV. Vive só no .env.local (gitignored):
# nenhum runner de CI e nenhum build EAS a possui, então em qualquer artefato ela é undefined.
# EXPO_PUBLIC_DEV_LOGIN_EMAIL=
# EXPO_PUBLIC_DEV_LOGIN_PASSWORD=

# EXPO_PUBLIC_BILLING_PUBLIC_KEY=      # fase Subscription (chave pública do provider)
# EXPO_PUBLIC_CRASH_DSN=               # fase Release (DSN público)
# EXPO_PUBLIC_ANALYTICS_KEY=           # fase Release (chave pública de ingest)

# --- supabase/ (CLI local) ---
SUPABASE_PROJECT_REF=           # projeto dev/staging — NUNCA prod em máquina local
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=          # token pessoal com escopo mínimo

# --- Edge Functions secrets (definidos via `supabase secrets set`, NÃO em arquivo) ---
# BILLING_WEBHOOK_SECRET
# (SUPABASE_SERVICE_ROLE_KEY é injetada pela plataforma; nunca copiar para o app)
